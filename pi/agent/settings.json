{
  "lastChangelogVersion": "0.87.1",
  "theme": "modus-operandi-tinted/modus-vivendi-tinted",
  "quietStartup": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "terminal": {
    "showTerminalProgress": false
  },
  "enableInstallTelemetry": false,
  "tuiMode": "fullscreen",
  "packages": [
    {
      "source": "~/.config/nono/packages/nolabs-ai/pi"
    },
    "npm:pi-vim",
    "npm:pi-btw",
    "npm:pi-web-search",
    "npm:pi-smart-fetch",
    "npm:pi-subagents-lite"
  ],
  "editorPaddingX": 1,
  "outputPad": 1,
  "defaultThinkingLevel": "high"
}