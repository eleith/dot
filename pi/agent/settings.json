{
  "lastChangelogVersion": "1.3.0",
  "theme": "modus-operandi-tinted/modus-vivendi-tinted",
  "quietStartup": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "terminal": {
    "showTerminalProgress": false
  },
  "enableInstallTelemetry": false,
  "tuiMode": "fullscreen",
  "packages": [
    {
      "source": "~/.config/nono/packages/nolabs-ai/pi"
    },
    "npm:pi-vim",
    "npm:pi-btw",
    "npm:pi-subagents-lite",
    "npm:@eleith-pi/title-status",
    "npm:@eleith-pi/progress",
    "npm:@eleith-pi/notifications",
    "npm:@eleith-pi/compact-editor-chrome",
    "npm:@eleith-pi/welcome",
    "npm:@eleith-pi/tool-rendering",
    "npm:@eleith-pi/web-search-codex",
    "npm:@eleith-pi/context-codex",
    "npm:@eleith-pi/web-fetch"
  ],
  "editorPaddingX": 1,
  "outputPad": 1,
  "defaultThinkingLevel": "high"
}